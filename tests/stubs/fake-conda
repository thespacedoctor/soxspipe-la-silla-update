#!/usr/bin/env bash
# STAND-IN FOR CONDA: `create` INSTALLS THE FAKE SOXSPIPE
echo "conda $*" >>"$CALLS"
prefix="$(dirname "$(dirname "$0")")"
case "$1" in
    create)
        [[ "${STUB_FAIL:-}" == "conda-create" ]] && exit 1
        mkdir -p "$prefix/envs/soxspipe/bin"
        cp "$STUBS_DIR/fake-soxspipe" "$prefix/envs/soxspipe/bin/soxspipe"
        ;;
    list)
        echo "# packages in environment"
        echo "soxspipe    9.9.9    pyhd8ed1ab_0    conda-forge"
        ;;
esac
